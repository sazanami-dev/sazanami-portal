# ---------- ビルド時（NEXT_PUBLIC_*） ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- DB（マイグレーション & 実行時） ----------
# プライベート網上の Postgres への接続文字列
DATABASE_URL=

# ---------- Supabase（実行時） ----------
SUPABASE_SERVICE_ROLE_KEY=
# サーバー側から Supabase へ接続する際の内部アドレス（例: http://10.0.0.x:8000）。
# Portal と Supabase が同一ネットワーク内にある場合に設定すると外部経由の往復を省ける。
# 使わないならキーごと書かない（コメントアウトのまま）でよい。
# SUPABASE_INTERNAL_URL=

# ---------- Discord（実行時） ----------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_INVITE_CHANNEL_ID=
DISCORD_INVITE_MAX_AGE=
DISCORD_ROLE_ID_MEMBER=
DISCORD_ROLE_ID_TEMPORARY=
# アナウンス用チャンネル（用途に応じて設定）
DISCORD_ANNOUNCE_CHANNEL_=

# ---------- GitHub App（実行時） ----------
GITHUB_ORG_NAME=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# 複数行の RSA 秘密鍵。改行を含むため設定時は注意。
GITHUB_APP_PRIVATE_KEY=

# ---------- Google（実行時） ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_GRANT_ROLE=

# ---------- Resend（メール送信・任意） ----------
# RESEND_API_KEY=
# MAIL_FROM=

# お知らせの Discord 通知に載せるポータルのURL
NEXT_PUBLIC_SITE_URL=
# 予約投稿を送信する cron エンドポイントの認証用
CRON_SECRET=
