# 環境変数のテンプレート。
# 実際の .env / .env.local は git 管理外（.gitignore）。値は各自で設定する。
#
# 【CI/CD での取り扱い】
#  - NEXT_PUBLIC_* … ビルド時にクライアントバンドルへインライン化されるため、
#    GitHub Actions の build-arg（GitHub Secrets）として渡す。
#  - DATABASE_URL  … マイグレーション（drizzle-kit migrate）時に GitHub Secrets から注入。
#  - それ以外の実行時シークレット … サーバー上の .env で管理し compose の env_file で注入。

# ---------- ビルド時（NEXT_PUBLIC_*） ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- DB（マイグレーション & 実行時） ----------
# Tailscale/プライベート網上の Postgres への接続文字列
DATABASE_URL=

# ---------- Supabase（実行時） ----------
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Discord（実行時） ----------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_INVITE_CHANNEL_ID=
DISCORD_INVITE_MAX_AGE=
DISCORD_ROLE_ID_MEMBER=
DISCORD_ROLE_ID_TEMPORARY=
# アナウンス用チャンネル（用途に応じて設定）
DISCORD_ANNOUNCE_CHANNEL_=

# ---------- GitHub App（実行時） ----------
GITHUB_ORG_NAME=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# 複数行の RSA 秘密鍵。改行を含むため設定時は注意。
GITHUB_APP_PRIVATE_KEY=

# ---------- Google（実行時） ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_GRANT_ROLE=

# ---------- Resend（メール送信・任意） ----------
# RESEND_API_KEY=
# MAIL_FROM=
